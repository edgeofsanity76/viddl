<Project>

  <!--
    Shared settings for every project in the repository.
    Version: change the major/minor here. Continuous-integration builds replace the patch number with the
    workflow run number (e.g. 2.0.57), and releases are tagged with that version.
  -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Product>viddl</Product>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
