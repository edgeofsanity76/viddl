<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Per-user installation: no administrator rights needed, installs to %LocalAppData%\Programs\viddl and adds a
    Start menu shortcut. Settings and downloads live in %LocalAppData%\viddl and are not touched by install,
    upgrade or uninstall, so a first install starts with default settings.
  -->
  <Package Name="viddl"
           Manufacturer="viddl"
           Version="$(ProductVersion)"
           UpgradeCode="D4F89B3C-2D2A-4C7C-B6D8-F4EC550A1C21"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of viddl is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="viddl.ico" SourceFile="$(sys.SOURCEFILEDIR)..\src\viddl.App\Assets\viddl.ico" />
    <Property Id="ARPPRODUCTICON" Value="viddl.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Save online videos as MP4." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/edgeofsanity76/viddl" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="viddl" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="7E0E3B5B-5A55-4E61-9C3E-4E3C7C2A8E51">
        <Shortcut Id="ViddlShortcut"
                  Name="viddl"
                  Description="Save online videos as MP4"
                  Target="[INSTALLFOLDER]viddl.exe"
                  Icon="viddl.ico"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\viddl" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="viddl">
      <!-- Everything the publish step produced: the app, the .NET runtime and the Windows App SDK. -->
      <Files Include="$(PublishDir)**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
